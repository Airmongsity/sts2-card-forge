<Page
    x:Class="CardForge.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:CardForge.Services"
    xmlns:c="using:CardForge.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="24,16" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind s:L.Z('生成队列','Generation queue')}" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="PauseBtn" Click="Pause_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Pause" />
                        <TextBlock Text="{x:Bind s:L.Z('暂停队列','Pause queue')}" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="SkipCoolBtn" Click="SkipCool_Click" Content="{x:Bind s:L.Z('跳过冷却','Skip cooldown')}" />
                <Button Click="CancelAll_Click" Content="{x:Bind s:L.Z('取消全部','Cancel all')}" />
                <Button Click="Clear_Click" Content="{x:Bind s:L.Z('清除已完成','Clear finished')}" />
            </StackPanel>
            <ListView x:Name="JobList" Grid.Row="2" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="s:Job">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="96" Height="72" CornerRadius="4" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <Image Source="{x:Bind Thumb}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Title}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind PromptText}" Style="{StaticResource Hint}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Message}" Style="{StaticResource Hint}" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                <ProgressBar Value="{x:Bind Percent}" Visibility="{x:Bind Active}" />
                            </StackPanel>
                            <Button Grid.Column="2" Tag="{x:Bind Id}" Click="CancelJob_Click" Visibility="{x:Bind Active}" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{x:Bind s:L.Z('取消','Cancel')}">
                                <SymbolIcon Symbol="Cancel" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="10">
            <c:ThermalScene x:Name="Scene" Height="400" />
            <Border Style="{StaticResource Panel}" Padding="0" Height="300">
                <Grid>
                    <Image x:Name="Preview" Stretch="Uniform" />
                    <TextBlock x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}" TextAlignment="Center" Margin="20" />
                </Grid>
            </Border>
            <TextBlock x:Name="WorkerInfo" Style="{StaticResource Hint}" />


            <Border Style="{StaticResource Panel}">
                <StackPanel Spacing="8">
                    <TextBlock Text="ComfyUI" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="ComfyInfo" Style="{StaticResource Hint}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="StartComfy_Click" Content="{x:Bind s:L.Z('启动','Start')}" />
                        <Button Click="StopComfy_Click" Content="{x:Bind s:L.Z('停止（释放显存）','Stop (free VRAM)')}" />
                        <Button Click="Log_Click" Content="{x:Bind s:L.Z('刷新日志','Refresh log')}" />
                    </StackPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="260"
                             FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
