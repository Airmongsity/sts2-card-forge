<Page
    x:Class="CardForge.Views.CardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:CardForge.Services"
    NavigationCacheMode="Required">

    <Grid ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- ============ card list ============ -->
        <Grid Padding="12,12,8,12" RowSpacing="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ComboBox x:Name="ProjectBox" IsEditable="True" HorizontalAlignment="Stretch"
                      Header="{x:Bind s:L.Z('项目','Project')}"
                      SelectionChanged="ProjectBox_SelectionChanged" TextSubmitted="ProjectBox_TextSubmitted" />
            <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="{x:Bind s:L.Z('搜索卡牌…','Search cards…')}" TextChanged="SearchBox_TextChanged" />
            <ListView x:Name="CardList" Grid.Row="2" SelectionMode="Single" SelectionChanged="CardList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="s:Card">
                        <Grid ColumnSpacing="10" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{x:Bind ClassBrush, Mode=OneWay}" RadiusX="2" RadiusY="2" />
                            <Border Grid.Column="1" Width="64" Height="48" CornerRadius="4" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{x:Bind PendingText, Mode=OneWay}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                <Button Click="NewCard_Click" ToolTipService.ToolTip="{x:Bind s:L.Z('新建卡牌','New card')}">
                    <SymbolIcon Symbol="Add" />
                </Button>
                <Button Click="Ideas_Click" ToolTipService.ToolTip="{x:Bind s:L.Z('AI 构思卡牌','Brainstorm cards with AI')}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE945;" FontSize="14" />
                        <TextBlock Text="{x:Bind s:L.Z('AI 构思','AI ideas')}" />
                    </StackPanel>
                </Button>
                <DropDownButton Content="{x:Bind s:L.Z('批量','Batch')}">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem Text="{x:Bind s:L.Z('为缺少提示词的卡生成提示词','Generate missing prompts')}" Click="BatchPrompts_Click" />
                            <MenuFlyoutItem Text="{x:Bind s:L.Z('为尚无图片的卡排队出图','Queue cards that have no images')}" Click="BatchGenerateMissing_Click" />
                            <MenuFlyoutItem Text="{x:Bind s:L.Z('为本项目全部卡排队出图','Queue every card in the project')}" Click="BatchGenerateAll_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind s:L.Z('导出本项目卡图到 MOD 文件夹…','Export project art to mod folder…')}" Click="ExportProject_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind s:L.Z('从 CSV 导入卡牌…','Import cards from CSV…')}" Click="ImportCsv_Click" />
                            <MenuFlyoutItem Text="{x:Bind s:L.Z('导出卡牌表为 CSV…','Export cards as CSV…')}" Click="ExportCsv_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Click="DeleteCard_Click" ToolTipService.ToolTip="{x:Bind s:L.Z('删除卡牌','Delete card')}">
                    <SymbolIcon Symbol="Delete" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ editor ============ -->
        <Grid Grid.Column="1">
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}" TextAlignment="Center"
                       Text="{x:Bind s:L.Z('先在“角色”页创建你的角色，再新建卡牌或用“AI 构思”批量生成卡牌创意。“示例 Examples”项目里有几张现成的示例卡。','Create your character on the Characters page first, then add cards or brainstorm a batch with AI ideas. The Examples project has a few finished sample cards.')}" />
            <ScrollViewer x:Name="Editor" Visibility="Collapsed">
                <StackPanel Padding="20,12,20,24" Spacing="10">
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="NameBox" Header="{x:Bind s:L.Z('卡牌名','Card name')}" />
                        <TextBox x:Name="SlugBox" Grid.Column="1" Header="{x:Bind s:L.Z('导出文件名','Export file name')}"
                                 PlaceholderText="sleeve_blade" />
                        <TextBox x:Name="CostBox" Grid.Column="2" Header="{x:Bind s:L.Z('费用','Cost')}" />
                        <ComboBox x:Name="ClassBox" Grid.Row="1" Header="{x:Bind s:L.Z('角色','Character')}" SelectionChanged="ClassBox_SelectionChanged" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectedValuePath="Id" />
                        <ComboBox x:Name="TypeBox" Grid.Row="1" Grid.Column="1" Header="{x:Bind s:L.Z('类型','Type')}" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectedValuePath="Id" />
                        <ComboBox x:Name="RarityBox" Grid.Row="1" Grid.Column="2" Header="{x:Bind s:L.Z('稀有度','Rarity')}" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectedValuePath="Id" />
                    </Grid>
                    <TextBox x:Name="DescBox" Header="{x:Bind s:L.Z('卡牌效果','Card text')}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                             PlaceholderText="{x:Bind s:L.Z('造成 6 点伤害。消耗。','Deal 6 damage. Exhaust.')}" />
                    <TextBox x:Name="ConceptBox" Header="{x:Bind s:L.Z('画面构思','Art concept')}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                             PlaceholderText="{x:Bind s:L.Z('一把紫色烟雾凝成的弯刀从破旧的袖口滑出','A curved blade of violet smoke sliding out of a ragged sleeve')}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RefBox" Header="{x:Bind s:L.Z('参考图','Reference image')}" IsReadOnly="True" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="…" Click="PickRef_Click" />
                        <Button Grid.Column="2" VerticalAlignment="Bottom" Click="ClearRef_Click" ToolTipService.ToolTip="{x:Bind s:L.Z('此卡不用参考图','No reference for this card')}" AutomationProperties.Name="{x:Bind s:L.Z('此卡不用参考图','No reference for this card')}"><SymbolIcon Symbol="Clear" /></Button>
                        <Button Grid.Column="3" VerticalAlignment="Bottom" Click="InheritRef_Click" ToolTipService.ToolTip="{x:Bind s:L.Z('恢复为角色参考图','Use the character reference')}" AutomationProperties.Name="{x:Bind s:L.Z('恢复为角色参考图','Use the character reference')}"><SymbolIcon Symbol="Contact" /></Button>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind s:L.Z('主题色','Theme colours')}" />
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="{x:Bind s:L.Z('第一个颜色是背景与暗部的主色，其余是光效的点缀色。','The first colour sets the background and shadows; the others are accents for light and effects.')}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel x:Name="ThemeColors" Orientation="Horizontal" Spacing="12" />
                            <Button x:Name="AddThemeBtn" Click="AddTheme_Click" ToolTipService.ToolTip="{x:Bind s:L.Z('添加颜色','Add a colour')}" AutomationProperties.Name="{x:Bind s:L.Z('添加颜色','Add a colour')}">
                                <SymbolIcon Symbol="Add" />
                            </Button>
                            <Button Click="RandomTheme_Click" ToolTipService.ToolTip="{x:Bind s:L.Z('随机颜色','Random colour')}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                    <TextBlock Text="{x:Bind s:L.Z('随机','Random')}" />
                                </StackPanel>
                            </Button>
                            <Button Click="InheritTheme_Click" ToolTipService.ToolTip="{x:Bind s:L.Z('恢复为角色颜色','Use the character colour')}" AutomationProperties.Name="{x:Bind s:L.Z('恢复为角色颜色','Use the character colour')}">
                                <SymbolIcon Symbol="Contact" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="PromptBtn" Click="GenPrompt_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="14" />
                                <TextBlock Text="{x:Bind s:L.Z('AI 生成提示词','Generate prompt with AI')}" />
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="PromptRing" IsActive="False" Width="20" Height="20" />
                        <TextBlock x:Name="PromptNotes" Style="{StaticResource Hint}" VerticalAlignment="Center" MaxWidth="480" />
                    </StackPanel>
                    <TextBox x:Name="PromptBox" Header="{x:Bind s:L.Z('图像提示词','Image prompt')}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                             PlaceholderText="sts2 card art, my_hero card. ..." TextChanged="PromptParts_TextChanged" />
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource Hint}" Text="{x:Bind s:L.Z('完整提示词','Full prompt')}" />
                            <TextBlock x:Name="FinalPromptText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Expander x:Name="ParamsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Header="{x:Bind s:L.Z('生成参数','Generation settings')}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <ComboBox x:Name="SizeBox" Header="{x:Bind s:L.Z('尺寸','Size')}" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectedValuePath="Id" />
                                <NumberBox x:Name="VariantsBox" Grid.Column="1" Header="{x:Bind s:L.Z('张数','Images')}" Minimum="1" Maximum="16" SpinButtonPlacementMode="Compact" />
                                <TextBox x:Name="SeedBox" Grid.Column="2" Header="{x:Bind s:L.Z('种子','Seed')}" />
                                <ComboBox x:Name="LoraBox" Grid.Row="1" Header="LoRA" HorizontalAlignment="Stretch" />
                                <NumberBox x:Name="StrengthBox" Grid.Row="1" Grid.Column="1" Header="{x:Bind s:L.Z('LoRA 强度','LoRA strength')}" Minimum="0" Maximum="2" SmallChange="0.05" SpinButtonPlacementMode="Compact" />
                                <NumberBox x:Name="CfgBox" Grid.Row="1" Grid.Column="2" Header="CFG" Minimum="1" Maximum="10" SmallChange="0.5" SpinButtonPlacementMode="Compact" />
                                <NumberBox x:Name="StepsBox" Grid.Row="2" Header="{x:Bind s:L.Z('步数','Steps')}" Minimum="8" Maximum="60" SpinButtonPlacementMode="Compact" />
                                <NumberBox x:Name="DenoiseBox" Grid.Row="2" Grid.Column="1" Header="{x:Bind s:L.Z('重绘幅度','Denoise')}" Minimum="0.1" Maximum="1" SmallChange="0.05" SpinButtonPlacementMode="Compact" />
                                <NumberBox x:Name="DraftCountBox" Grid.Row="2" Grid.Column="2" Header="{x:Bind s:L.Z('草图张数','Drafts per run')}" Minimum="1" Maximum="8" SpinButtonPlacementMode="Compact" />
                                <CheckBox x:Name="DraftFastBox" Grid.Row="3" Grid.ColumnSpan="3"
                                          Content="{x:Bind s:L.Z('草图加速','Fast drafts')}"
                                          ToolTipService.ToolTip="{x:Bind s:L.Z('EasyCache：草图约快一倍，细节更糊，构图不变','EasyCache: drafts about 2x faster, blurrier details, same composition')}" />
                            </Grid>
                            <TextBox x:Name="SuffixBox" TextChanged="PromptParts_TextChanged" Header="{x:Bind s:L.Z('风格后缀','Style suffix')}" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBox x:Name="NegativeBox" Header="{x:Bind s:L.Z('负面提示词','Negative prompt')}" AcceptsReturn="True" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InitBox" Header="{x:Bind s:L.Z('起始图','Start image')}" IsReadOnly="True" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="…" Click="PickInit_Click" />
                                <Button Grid.Column="2" VerticalAlignment="Bottom" Click="ClearInit_Click"><SymbolIcon Symbol="Clear" /></Button>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{x:Bind s:L.Z('CFG 3.0 与负面提示词最影响画质；写具体的细节，空泛的形容词没有用。','CFG 3.0 and the negative prompt matter most; concrete details work, vague adjectives do nothing.')}" />
                        </StackPanel>
                    </Expander>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button x:Name="DraftBtn" Style="{StaticResource AccentButtonStyle}" Click="Draft_Click"
                                ToolTipService.ToolTip="{x:Bind s:L.Z('快速画出几张草图：每张是成品的前几步，画面模糊，但构图、颜色和光影就是成品的样子。挑中一张后右键选“精绘”，从它接着画完。','Quickly draws several drafts: each is the first steps of its final image, blurry but with the final composition, colours and light. Right-click the one you like and choose Paint final to finish it.')}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="ViewAll" />
                                <TextBlock Text="{x:Bind s:L.Z('抽草图','Draw drafts')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GenerateBtn" Click="Generate_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Play" />
                                <TextBlock Text="{x:Bind s:L.Z('生成卡图','Generate art')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AbortBtn" Click="Abort_Click" Visibility="Collapsed"
                                ToolTipService.ToolTip="{x:Bind s:L.Z('中止正在绘制的这张图','Stop the image being drawn')}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Stop" />
                                <TextBlock Text="{x:Bind s:L.Z('中止此张','Stop this image')}" />
                            </StackPanel>
                        </Button>
                        <Button Click="Save_Click" Content="{x:Bind s:L.Z('保存','Save')}" />
                        <TextBlock x:Name="SavedText" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ art ============ -->
        <Grid Grid.Column="2" Padding="8,12,12,12" RowSpacing="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}" Height="330">
                <Grid Background="Transparent" PointerEntered="ArtBox_PointerEntered" PointerExited="ArtBox_PointerExited">
                    <Image x:Name="ArtImage" Stretch="Uniform" />
                    <Image x:Name="LivePreview" Stretch="Uniform" Visibility="Collapsed" />
                    <TextBlock x:Name="ArtHint" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"
                               Text="{x:Bind s:L.Z('还没有卡图','No art yet')}" />
                    <Button x:Name="AbortOverlay" Visibility="Collapsed" Click="Abort_Click" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                            ToolTipService.ToolTip="{x:Bind s:L.Z('中止正在绘制的这张图','Stop the image being drawn')}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Stop" />
                            <TextBlock Text="{x:Bind s:L.Z('中止','Stop this image')}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Spacing="4">
                <ProgressBar x:Name="CardProgress" Visibility="Collapsed" />
                <TextBlock x:Name="CardJobText" Style="{StaticResource Hint}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind s:L.Z('候选图','Variants')}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button Click="ExportCard_Click" Content="{x:Bind s:L.Z('导出卡图…','Export art…')}" />
            </StackPanel>
            <GridView x:Name="VariantGrid" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True" ItemClick="VariantGrid_ItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="s:ImageRec">
                        <Grid Width="184" Height="138" CornerRadius="6" RightTapped="Variant_RightTapped" Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Image Source="{x:Bind Thumb}" Stretch="UniformToFill" />
                            <TextBlock Text="{x:Bind FavGlyph, Mode=OneWay}" Foreground="Gold" Margin="6,2" FontSize="16" />
                            <Border Visibility="{x:Bind DraftBadge}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                                    Padding="6,1" CornerRadius="4" Background="#B0000000">
                                <TextBlock Text="{x:Bind s:L.Z('草图','Draft')}" Foreground="White" FontSize="12" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <!-- ============ dialogs ============ -->
        <ContentDialog x:Name="IdeasDialog" Grid.ColumnSpan="3"
                       Title="{x:Bind s:L.Z('AI 构思卡牌','Brainstorm cards')}"
                       PrimaryButtonText="{x:Bind s:L.Z('添加选中的卡牌','Add selected cards')}"
                       CloseButtonText="{x:Bind s:L.Z('关闭','Close')}" DefaultButton="Primary">
            <StackPanel Spacing="10" Width="640">
                <TextBox x:Name="ThemeBox" Header="{x:Bind s:L.Z('主题 / 机制','Theme / mechanics')}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                         PlaceholderText="{x:Bind s:L.Z('例：毒素叠层、弃牌触发效果、低费连击…','e.g. stacking poison, on-discard triggers, cheap combo attacks…')}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox x:Name="IdeaClassBox" Header="{x:Bind s:L.Z('角色','Character')}" DisplayMemberPath="Name" SelectedValuePath="Id" MinWidth="200" />
                    <NumberBox x:Name="IdeaCountBox" Header="{x:Bind s:L.Z('数量','Count')}" Minimum="1" Maximum="20" Value="5" SpinButtonPlacementMode="Compact" />
                    <Button x:Name="IdeaGoBtn" VerticalAlignment="Bottom" Content="{x:Bind s:L.Z('生成','Generate')}" Click="IdeaGo_Click" Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing x:Name="IdeaRing" IsActive="False" VerticalAlignment="Bottom" Width="24" Height="24" />
                </StackPanel>
                <ListView x:Name="IdeaList" MaxHeight="380" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="s:IdeaCard">
                            <CheckBox IsChecked="{x:Bind Include, Mode=TwoWay}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Concept}" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="ExportDialog" Grid.ColumnSpan="3"
                       Title="{x:Bind s:L.Z('导出卡图','Export card art')}"
                       PrimaryButtonText="{x:Bind s:L.Z('导出','Export')}"
                       CloseButtonText="{x:Bind s:L.Z('取消','Cancel')}" DefaultButton="Primary">
            <StackPanel Spacing="10" Width="560">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ExportDirBox" Header="{x:Bind s:L.Z('目标文件夹','Target folder')}" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="…" Click="PickExportDir_Click" />
                </Grid>
                <ComboBox x:Name="ExportSizeBox" Header="{x:Bind s:L.Z('尺寸','Size')}" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectedValuePath="Id" />
                <CheckBox x:Name="ExportByClass" Content="{x:Bind s:L.Z('按角色分子文件夹','One subfolder per character')}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="{x:Bind s:L.Z('导出每张卡选中的卡图，以导出文件名命名。原版尺寸：普通卡 1000×760，远古/全图卡 606×852。','Exports each card selected art, named after its export file name. Native sizes: 1000x760 for normal cards, 606x852 for ancient / full-art cards.')}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
