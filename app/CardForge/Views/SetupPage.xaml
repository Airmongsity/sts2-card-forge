<Page
    x:Class="CardForge.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:CardForge.Services"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="12" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind s:L.Z('环境安装','Setup')}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Bind s:L.Z('一键下载并配置本地出图所需的全部组件（约 14 GB）。下载支持断点续传并校验 SHA-256，某个源不可用时会自动换源；已存在的文件会被跳过。支持 NVIDIA（GTX 900 系起）、AMD（RX 6000 起，Windows 11）与 Intel Arc 显卡，建议 8 GB 显存以上。',
                                           'Downloads and configures everything needed for local generation (~14 GB). Downloads resume, are SHA-256 verified and switch source automatically when one fails; files already present are skipped. Supports NVIDIA (GTX 900 series and newer), AMD (RX 6000 and newer, Windows 11) and Intel Arc GPUs; 8 GB VRAM or more recommended.')}" />

            <Border Style="{StaticResource Panel}">
                <Grid ColumnSpacing="16" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{x:Bind s:L.Z('显卡','GPU')}" VerticalAlignment="Center" />
                    <TextBlock x:Name="GpuText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Text="{x:Bind s:L.Z('运行包','Package')}" VerticalAlignment="Center" />
                    <ComboBox x:Name="PackageBox" Grid.Row="1" Grid.Column="1" MinWidth="360" SelectionChanged="PackageBox_SelectionChanged" />

                    <InfoBar x:Name="GpuWarn" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Severity="Warning" IsClosable="False" />

                    <TextBlock Grid.Row="3" Text="{x:Bind s:L.Z('模型量化','Model quant')}" VerticalAlignment="Center" />
                    <ComboBox x:Name="QuantBox" Grid.Row="3" Grid.Column="1" MinWidth="360" SelectionChanged="QuantBox_SelectionChanged" />

                    <TextBlock Grid.Row="4" Text="ComfyUI" VerticalAlignment="Center" />
                    <TextBox x:Name="ComfyPath" Grid.Row="4" Grid.Column="1" IsReadOnly="True" />
                    <Button Grid.Row="4" Grid.Column="2" Content="{x:Bind s:L.Z('选择已有 ComfyUI…','Use existing ComfyUI…')}" Click="PickComfy_Click" />

                    <TextBlock Grid.Row="5" Text="{x:Bind s:L.Z('下载源','Download source')}" VerticalAlignment="Center" />
                    <ComboBox x:Name="SourceBox" Grid.Row="5" Grid.Column="1" MinWidth="360" SelectionChanged="SourceBox_SelectionChanged" />

                    <TextBlock Grid.Row="6" Text="{x:Bind s:L.Z('GitHub 代理','GitHub proxy')}" VerticalAlignment="Center" />
                    <TextBox x:Name="GithubProxyBox" Grid.Row="6" Grid.Column="1" LostFocus="GithubProxyBox_LostFocus"
                             PlaceholderText="{x:Bind s:L.Z('可选，如 https://ghfast.top/ ，用于下载 ComfyUI 与节点','Optional, e.g. https://ghfast.top/, used for ComfyUI and node downloads')}" />

                    <TextBlock Grid.Row="7" Text="{x:Bind s:L.Z('网络代理','Network proxy')}" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="7" Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="NetProxyBox" MinWidth="200" SelectionChanged="NetProxyBox_SelectionChanged" />
                            <TextBox x:Name="NetProxyUrl" MinWidth="240" Visibility="Collapsed" LostFocus="NetProxyUrl_LostFocus"
                                     PlaceholderText="http://127.0.0.1:7890" />
                        </StackPanel>
                        <TextBlock x:Name="NetProxyStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Row="7" Grid.Column="2" VerticalAlignment="Top" Content="{x:Bind s:L.Z('重新检测','Detect again')}" Click="NetProxyDetect_Click"
                            ToolTipService.ToolTip="{x:Bind s:L.Z('刚打开代理软件后点这里','Click after starting your proxy app')}" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="InstallAll" Style="{StaticResource AccentButtonStyle}" Click="InstallAll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="{x:Bind s:L.Z('一键安装缺失组件','Install everything missing')}" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelBtn" Content="{x:Bind s:L.Z('取消','Cancel')}" Click="Cancel_Click" IsEnabled="False" />
                <Button Content="{x:Bind s:L.Z('重新检查','Re-check')}" Click="Recheck_Click" />
                <CheckBox x:Name="IncludeLora" IsChecked="True" Content="{x:Bind s:L.Z('包含风格 LoRA','Include the style LoRA')}" />
                <Button Content="{x:Bind s:L.Z('复制下载链接','Copy download links')}" Click="CopyLinks_Click" />
                <Button Content="{x:Bind s:L.Z('打开模型文件夹','Open models folder')}" Click="OpenModels_Click" />
                <Button Content="{x:Bind s:L.Z('安装日志','Install log')}" Click="OpenLog_Click" />
            </StackPanel>

            <ItemsControl x:Name="StepsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="s:SetupStep">
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Foreground="{x:Bind GlyphBrush, Mode=OneWay}" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource Hint}" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource Hint}" MaxLines="8" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind Indeterminate, Mode=OneWay}"
                                                 Visibility="{x:Bind Busy, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="2" Tag="{x:Bind Id}" Click="InstallOne_Click" VerticalAlignment="Top"
                                        Content="{x:Bind s:L.Z('安装','Install')}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <InfoBar x:Name="DoneBar" Severity="Success" IsClosable="False"
                     Title="{x:Bind s:L.Z('环境就绪','All set')}"
                     Message="{x:Bind s:L.Z('所有组件已安装。前往“卡牌”页开始创作。','Everything is installed. Head to Cards to start.')}">
                <InfoBar.ActionButton>
                    <Button Content="{x:Bind s:L.Z('开始使用','Get started')}" Click="GoCards_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock Style="{StaticResource Hint}"
                       Text="{x:Bind s:L.Z('许可：Qwen-Image-2.1 与本 LoRA 遵循 Qwen RESEARCH LICENSE，仅限非商业用途（研究/评估）。生成的卡图同样不得商用。',
                                           'License: Qwen-Image-2.1 and the LoRA are under the Qwen RESEARCH LICENSE, non-commercial use only (research/evaluation). Generated art may not be used commercially either.')}" />
        </StackPanel>
    </ScrollViewer>
</Page>
