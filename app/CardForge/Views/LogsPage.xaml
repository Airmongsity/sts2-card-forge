<Page
    x:Class="CardForge.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="using:CardForge.Services"
    NavigationCacheMode="Required">

    <Grid Padding="32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Bind s:L.Z('日志','Logs')}" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" TextWrapping="Wrap"
                   Text="{x:Bind s:L.Z('集中查看后端输出、最近任务、ComfyUI、安装和更新日志。报告问题时可直接复制“全部日志”。API key 不会写入任务日志。','Backend output, recent jobs, ComfyUI, setup, and update logs in one place. Copy All logs when reporting a problem. API keys are not written to job logs.')}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="LogSourceBox" MinWidth="220" DisplayMemberPath="Name" SelectionChanged="LogSourceBox_SelectionChanged" />
            <Button Click="Refresh_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Refresh" /><TextBlock Text="{x:Bind s:L.Z('刷新','Refresh')}" /></StackPanel></Button>
            <Button Click="Copy_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Copy" /><TextBlock Text="{x:Bind s:L.Z('复制','Copy')}" /></StackPanel></Button>
            <Button Click="OpenFolder_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="OpenLocal" /><TextBlock Text="{x:Bind s:L.Z('打开日志文件夹','Open log folder')}" /></StackPanel></Button>
            <ProgressRing x:Name="LoadingRing" Width="22" Height="22" IsActive="False" />
            <TextBlock x:Name="LogStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
